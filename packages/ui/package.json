{
  "name": "@plan-presenter/ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "plan-presenter web UI: renders MDX sessions with click-anywhere inline feedback. Also exported as an embeddable React component.",
  "exports": {
    ".": "./src/lib.ts"
  },
  "scripts": {
    "dev": "vite --port 27412 --strictPort",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@plan-presenter/protocol": "workspace:*",
    "mermaid": "^11.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
