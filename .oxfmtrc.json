{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "artifacts",
    "bun.lock",
    "examples/**/feedback.json"
  ]
}
